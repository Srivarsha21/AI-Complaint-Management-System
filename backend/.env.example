# Copy this file to .env and adjust values. Never commit .env.

APP_NAME="AI Complaint Management System"
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://complaints:CHANGE_ME@localhost:5432/complaints

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Authentication. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# "Continue with Google" sign-in (optional; the button is hidden when empty).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:5173 and your deployed site URL.
GOOGLE_CLIENT_ID=

# Google Gemini (optional). Get a key at https://aistudio.google.com/apikey
# Without a key, the chatbot and translation use their non-AI fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# Image analysis: OpenCV quality checks + YOLOv8n (COCO objects only; it cannot
# detect potholes, garbage etc.). Weights (~6 MB) are downloaded on first use
# into VISION_WEIGHTS_DIR unless VISION_ALLOW_WEIGHTS_DOWNLOAD=false.
MAX_IMAGE_PIXELS=40000000
VISION_DETECTOR_ENABLED=true
VISION_WEIGHTS_DIR=app/ai/weights
VISION_MODEL_FILE=yolov8n.pt
VISION_ALLOW_WEIGHTS_DOWNLOAD=true
VISION_CONFIDENCE_THRESHOLD=0.35
VISION_MAX_IMAGE_SIDE=1280
VISION_TIMEOUT_SECONDS=20
VISION_BLUR_THRESHOLD=100
VISION_DARK_THRESHOLD=50
VISION_BRIGHT_THRESHOLD=215

# Per-user limits for image analysis and translation; maximum text length to translate.
AI_RATE_LIMIT_ATTEMPTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
TRANSLATION_MAX_CHARS=5000
# Location guidance chatbot. Geocoding uses OpenStreetMap Nominatim (max 1 request/second).
# Set a contact email so the Nominatim operators can reach you (usage policy).
GEOCODING_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ResolveAI-complaint-system/0.1
NOMINATIM_CONTACT_EMAIL=
GEOCODING_TIMEOUT_SECONDS=8
CHATBOT_RATE_LIMIT_ATTEMPTS=30
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60

# Email (optional). Without SMTP, development mode prints reset links to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# First administrator, used by: python -m app.scripts.create_admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# AI / NLP (module 5). Model artifacts are committed; retrain with: python -m app.ai.train
AI_ARTIFACTS_DIR=app/ai/artifacts
AI_DUPLICATE_WINDOW_DAYS=30
AI_DUPLICATE_THRESHOLD=0.35
AI_DUPLICATE_MAX_DISTANCE_M=500
AI_DUPLICATE_MAX_RESULTS=5
AI_ANALYZE_RATE_LIMIT_ATTEMPTS=30
AI_ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60

# Shared password for the fictional demo accounts created by: python -m app.scripts.seed_demo --reset
# (generated automatically on first run if left empty)
DEMO_PASSWORD=
